# ==========================================================
# Silayi Master Backend - Environment Configuration Template
# Copy this file to .env and fill in your production credentials
# NOTE: Only dummy/placeholder values are kept in this template!
# ==========================================================

# Server Port (configured for Docker port 3003)
PORT=3003

# Node Environment (production / development)
NODE_ENV=production

# MongoDB Connection String (Placeholder - replace in your real .env file)
# For MongoDB Atlas (cloud):
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/?appName=silayi-master
# For self-hosted / Docker MongoDB:
# MONGODB_URI=mongodb://mongodb:27017/silayi_master

# MongoDB Database Name
MONGODB_DB_NAME=silayi_master

# Secret key for signing JWT tokens (replace with a secure random 64-character string in .env)
JWT_SECRET=replace_this_with_your_secure_jwt_secret_key_in_production
